{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dest_csvfile_nasa",
						"type": "DatasetReference"
					},
					"name": "destcsvnasa",
					"description": "Import data from dest"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "reporting_csv_nasa",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select2"
				},
				{
					"name": "filter1",
					"description": "orbit body and equinox filter"
				},
				{
					"name": "nullcountaggregate"
				},
				{
					"name": "select3",
					"description": "dropping equinox and orbiting body column"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Neo Reference ID} as integer,",
				"          Name as integer,",
				"          {Absolute Magnitude} as double,",
				"          {Est Dia in KM(min)} as double,",
				"          {Est Dia in KM(max)} as double,",
				"          {Est Dia in M(min)} as double,",
				"          {Est Dia in M(max)} as double,",
				"          {Est Dia in Miles(min)} as double,",
				"          {Est Dia in Miles(max)} as double,",
				"          {Est Dia in Feet(min)} as double,",
				"          {Est Dia in Feet(max)} as double,",
				"          {Close Approach Date} as date,",
				"          {Epoch Date Close Approach} as long,",
				"          {Relative Velocity km per sec} as double,",
				"          {Relative Velocity km per hr} as double,",
				"          {Miles per hour} as double,",
				"          {Miss Dist.(Astronomical)} as double,",
				"          {Miss Dist.(lunar)} as double,",
				"          {Miss Dist.(kilometers)} as double,",
				"          {Miss Dist.(miles)} as double,",
				"          {Orbiting Body} as string,",
				"          {Orbit ID} as short,",
				"          {Orbit Determination Date} as timestamp,",
				"          {Orbit Uncertainity} as short,",
				"          {Minimum Orbit Intersection} as double,",
				"          {Jupiter Tisserand Invariant} as double,",
				"          {Epoch Osculation} as double,",
				"          Eccentricity as double,",
				"          {Semi Major Axis} as double,",
				"          Inclination as double,",
				"          {Asc Node Longitude} as double,",
				"          {Orbital Period} as double,",
				"          {Perihelion Distance} as double,",
				"          {Perihelion Arg} as double,",
				"          {Aphelion Dist} as double,",
				"          {Perihelion Time} as double,",
				"          {Mean Anomaly} as double,",
				"          {Mean Motion} as double,",
				"          Equinox as string,",
				"          Hazardous as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> destcsvnasa",
				"destcsvnasa select(mapColumn(",
				"          {Neo Reference ID},",
				"          {Absolute Magnitude},",
				"          {Est Dia in M(min)},",
				"          {Est Dia in M(max)},",
				"          {Close Approach Date},",
				"          {Relative Velocity km per sec},",
				"          {(kilometers)} = {Miss Dist.(kilometers)},",
				"          {Orbiting Body},",
				"          {Orbit Determination Date},",
				"          {Orbit Uncertainity},",
				"          {Minimum Orbit Intersection},",
				"          {Jupiter Tisserand Invariant},",
				"          {Epoch Osculation},",
				"          Eccentricity,",
				"          {Semi Major Axis},",
				"          Inclination,",
				"          {Asc Node Longitude},",
				"          {Orbital Period},",
				"          {Perihelion Distance},",
				"          {Perihelion Arg},",
				"          {Aphelion Dist},",
				"          {Perihelion Time},",
				"          {Mean Anomaly},",
				"          {Mean Motion},",
				"          Equinox,",
				"          Hazardous",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 split(Hazardous==true(),",
				"     disjoint: false) ~> split1@(hazardous, nonhazardous)",
				"split1@hazardous derive({Est Dia avg (M)} = ({Est Dia in M(min)}+{Est Dia in M(max)})/2) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          {Neo Reference ID},",
				"          {Absolute Magnitude},",
				"          {Close Approach Date},",
				"          {Relative Velocity km per sec},",
				"          {(kilometers)},",
				"          {Orbiting Body},",
				"          {Orbit Determination Date},",
				"          {Orbit Uncertainity},",
				"          {Minimum Orbit Intersection},",
				"          {Jupiter Tisserand Invariant},",
				"          {Epoch Osculation},",
				"          Eccentricity,",
				"          {Semi Major Axis},",
				"          Inclination,",
				"          {Asc Node Longitude},",
				"          {Orbital Period},",
				"          {Perihelion Distance},",
				"          {Perihelion Arg},",
				"          {Aphelion Dist},",
				"          {Perihelion Time},",
				"          {Mean Anomaly},",
				"          {Mean Motion},",
				"          Equinox,",
				"          Hazardous,",
				"          {Est Dia avg (M)}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 filter(or({Orbiting Body}!='Earth' , {Equinox}!='J2000')) ~> filter1",
				"select1 aggregate(each(match(true()), $$ = countIf(isNull($$)))) ~> nullcountaggregate",
				"filter1 select(mapColumn(",
				"          {Neo Reference ID},",
				"          {Absolute Magnitude},",
				"          {Close Approach Date},",
				"          {Relative Velocity km per sec},",
				"          {(kilometers)},",
				"          {Orbit Determination Date},",
				"          {Orbit Uncertainity},",
				"          {Minimum Orbit Intersection},",
				"          {Jupiter Tisserand Invariant},",
				"          {Epoch Osculation},",
				"          Eccentricity,",
				"          {Semi Major Axis},",
				"          Inclination,",
				"          {Asc Node Longitude},",
				"          {Orbital Period},",
				"          {Perihelion Distance},",
				"          {Perihelion Arg},",
				"          {Aphelion Dist},",
				"          {Perihelion Time},",
				"          {Mean Anomaly},",
				"          {Mean Motion},",
				"          Equinox,",
				"          Hazardous,",
				"          {Est Dia avg (M)}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}