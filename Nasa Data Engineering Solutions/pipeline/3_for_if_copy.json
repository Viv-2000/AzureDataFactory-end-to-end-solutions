{
	"name": "3_for_if_copy",
	"properties": {
		"activities": [
			{
				"name": "Set variable for childitems of metadata output",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Metadata for source csvs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "file_names",
					"value": {
						"value": "@activity('Get Metadata for source csvs').output.childItems",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach file in var file_name-value",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Set variable for childitems of metadata output",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('file_names')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If Condition for checking file name starting with nasa",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@startswith(item().name, 'nasa')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy data from source to destination",
										"description": "the source is parameterised\ncreate a parameter for filename in source dataset\nuse item().name in the parameter value",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "parameterized_source_csvfiles",
												"type": "DatasetReference",
												"parameters": {
													"p_filename": "@item().name"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "parameterised_destination_csvfiles",
												"type": "DatasetReference",
												"parameters": {
													"p_filename": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Get Metadata for source csvs",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "sourcecsvs",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"variables": {
			"file_names": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-23T07:01:23Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}